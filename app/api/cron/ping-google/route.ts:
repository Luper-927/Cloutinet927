import { NextRequest, NextResponse } from 'next/server'
import { getProfileCount, getProductCount, SITEMAP_CHUNK_SIZE } from '../../../../lib/sitemap-helpers'

const ALERT_EMAIL = 'luperabenga8@gmail.com'

async function sendFailureAlert(details: string) {
  const apiKey = process.env.RESEND_API_KEY
  if (!apiKey) return

  try {
    await fetch('https://api.resend.com/emails', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + apiKey,
      },
      body: JSON.stringify({
        from: 'Cloutinet Alerts <alerts@cloutinet.online>',
        to: ALERT_EMAIL,
        subject: '⚠️ Cloutinet: Google ping cron failed',
        text: 'The daily Google sitemap ping job ran into a problem:\n\n' + details,
      }),
    })
  } catch (e) {
    // If even the alert email fails, there's nothing more we can do here.
  }
}

export async function GET(req: NextRequest) {
  // Fails closed: if CRON_SECRET is ever missing for any reason, this now
  // rejects the request rather than silently skipping the check.
  const authHeader = req.headers.get('authorization')
  if (authHeader !== `Bearer ${process.env.CRON_SECRET}`) {
    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
  }

  const [profileCount, productCount] = await Promise.all([getProfileCount(), getProductCount()])
  const storeChunks = Math.max(1, Math.ceil(profileCount / SITEMAP_CHUNK_SIZE))
  const productChunks = Math.max(1, Math.ceil(productCount / SITEMAP_CHUNK_SIZE))

  const sitemapUrls = [
    'https://cloutinet.online/sitemap.xml',
    ...Array.from({ length: storeChunks }, (_, i) => `https://cloutinet.online/store-sitemap/sitemap/${i}.xml`),
    ...Array.from({ length: productChunks }, (_, i) => `https://cloutinet.online/product-sitemap/sitemap/${i}.xml`),
  ]

  const results = []
  let hadFailure = false

  for (const sitemapUrl of sitemapUrls) {
    try {
      const pingUrl = `https://www.google.com/ping?sitemap=${encodeURIComponent(sitemapUrl)}`
      const response = await fetch(pingUrl)
      results.push({ sitemap: sitemapUrl, status: response.status, ok: response.ok })
      if (!response.ok) hadFailure = true
    } catch (e: any) {
      results.push({ sitemap: sitemapUrl, error: e.message })
      hadFailure = true
    }
  }

  if (hadFailure) {
    await sendFailureAlert(JSON.stringify(results, null, 2))
  }

  return NextResponse.json({ pinged_at: new Date().toISOString(), results })
}
